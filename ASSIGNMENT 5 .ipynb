# Q5
# ==============================
ucs420SahilSharma = np.array([
    [10, 20, 30, 40],
    [50, 60, 70, 80],
    [90, 15, 20, 35]
])

# Mean
print(np.mean(ucs420SahilSharma))

# Median
print(np.median(ucs420SahilSharma))

# Maximum
print(np.max(ucs420SahilSharma))

# Minimum
print(np.min(ucs420SahilSharma))

# Unique elements
print(np.unique(ucs420SahilSharma))

# Reshape
reshapeducs420SahilSharma = np.reshape(ucs420SahilSharma, (4, 3))
print(reshapeducs420SahilSharma)

# Resize
resizeducs420SahilSharma = np.resize(ucs420SahilSharma, (2, 3))
print(resizeducs420SahilSharma)
