# ==============================
# Q4
# ==============================
SahilSharma = np.linspace(10, 100, 25)

print(SahilSharma)

# Dimensions
print(SahilSharma.ndim)

# Shape
print(SahilSharma.shape)

# Total number of elements
print(SahilSharma.size)

# Data type
print(SahilSharma.dtype)

# Total bytes consumed
print(SahilSharma.nbytes)

# Reshape
reshapedarr = SahilSharma.reshape(SahilSharma.size, 1)
print(reshapedarr)

# Reshape using .T attribute
Treshape = SahilSharma.reshape(-1, 1)
arrreshape = Treshape.T
print(arrreshape)


