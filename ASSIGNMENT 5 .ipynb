arr = [1, 2, 3, 4]
n = len(arr)

arr2 = [0] * n
for i in range(n):
    arr2[i] = arr[i] + 2
print(arr2)

arr3 = [0] * n
for i in range(0, n):
    arr3[i] = arr[i] * 3
print(arr3)

arr4 = [0] * n
for i in range(0, n):
    arr4[i] = arr[i] / 2
print(arr4)


